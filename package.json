{
	"name": "@anweb/chunker",
	"version": "0.2.1",
	"description": "Split markdown or plain text into token-bounded chunks along headings, with source offsets, heading paths and optional overlap",
	"license": "MIT",
	"homepage": "https://github.com/ANLTD/chunker#readme",
	"keywords": [
		"chunking",
		"text-splitter",
		"markdown",
		"rag",
		"embeddings",
		"tokens"
	],
	"author": {
		"name": "ANLTD",
		"email": "contact@anweb.jp"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ANLTD/chunker.git"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsup",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "node scripts/prepublish.js && npm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"js-tiktoken": "^1.0.21",
		"tsup": "^8.5.0",
		"typescript": "~5.9.2",
		"vitest": "^3.2.4"
	}
}
